# Copy to .env and fill in. Never commit the real .env.
# In docker-compose the Redis / service-URL values are overridden automatically.

PORT=8003
APP_NAME=allocation_svc
LOG_LEVEL=info

# Same database as res_manage_svc (reads the inventories collection, writes allocation_requests)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/smart_allocate?retryWrites=true&w=majority

# Must match auth_svc
JWT_ACCESS_SECRET=change-me
INTERNAL_API_KEY=change-me-shared-between-services

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

RES_MANAGE_SERVICE_URL=http://localhost:8002
