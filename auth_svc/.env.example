# Copy to .env and fill in. Never commit the real .env.
# In docker-compose the Redis / service-URL / NODE_ENV values are overridden automatically.

PORT=8000
NODE_ENV=development

# MongoDB (Atlas). All services use the same database.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/smart_allocate?retryWrites=true&w=majority

# Must be IDENTICAL in auth_svc, ngo_svc, res_manage_svc and allocation_svc.
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
INTERNAL_API_KEY=change-me-shared-between-services

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

NGO_SERVICE_URL=http://localhost:8001
RES_SERVICE_URL=http://localhost:8002

# Password-reset emails (Mailtrap sandbox in dev, a real SMTP provider in production)
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USERNAME=
EMAIL_PASSWORD=

GOOGLE_CLIENT_ID=

# Optional: per-IP requests per 15 min on public routes (default 1000 in dev, 100 in production)
# RATE_LIMIT_MAX=100
