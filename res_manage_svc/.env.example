# Copy to .env and fill in. Never commit the real .env.
# In docker-compose the Redis / service-URL / NODE_ENV values are overridden automatically.

PORT=8002
NODE_ENV=development

# Needs a replica set (Atlas is one): restock / reserve use MongoDB transactions.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/smart_allocate?retryWrites=true&w=majority

# Must match auth_svc
JWT_ACCESS_SECRET=change-me
INTERNAL_API_KEY=change-me-shared-between-services

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

AUTH_SERVICE_URL=http://localhost:8000
NGO_SERVICE_URL=http://localhost:8001

# RATE_LIMIT_MAX=100
